{
  "id": "activity-digest",
  "name": "Activity digest",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Observe Studio business events and produce a recurring or workflow-triggered digest.",
  "server": "server.mjs",
  "permissions": [
    "events",
    "automation",
    "commands"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "intervalMs": {
        "type": "integer",
        "minimum": 10000,
        "default": 60000
      }
    },
    "additionalProperties": false
  },
  "author": {
    "name": "AgentHub",
    "url": "https://github.com/forhetale"
  },
  "repository": "https://github.com/forhetale/agenthub",
  "documentation": "https://github.com/forhetale/agenthub/blob/main/docs/plugins.md"
}
